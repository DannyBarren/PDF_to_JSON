# ---------------------------------------------------------------------------
# PDF -> JSON Template Translator configuration
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Your OpenAI API key. Required for the LLM generation stage.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model used for the reasoning / generation stage.
# Any model that supports JSON response format works (e.g. gpt-4o, gpt-4o-mini).
PDF_TO_JSON_MODEL=gpt-4o

# Optional: override the OpenAI base URL (e.g. for Azure or a proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: sampling temperature for generation (default 0.2 for consistency).
PDF_TO_JSON_TEMPERATURE=0.2

# Optional: request timeout in seconds for the LLM call (default 120).
PDF_TO_JSON_TIMEOUT=120
